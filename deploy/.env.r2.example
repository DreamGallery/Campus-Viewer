# R2 Object Read & Write credentials scoped to hatsuboshi. Never commit real keys.
CAMPUS_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CAMPUS_R2_BUCKET=YOUR_BUCKET_NAME
CAMPUS_R2_PREFIX=campus-v1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CAMPUS_UPDATE_INTERVAL=21600
CAMPUS_DOWNLOAD_WORKERS=4
CAMPUS_EXTRACT_WORKERS=2
CAMPUS_UPLOAD_WORKERS=4
CAMPUS_R2_PUBLIC_BASE_URL=

# Music: vocal excludes instrumentals and BGM; all includes every Music entry.
CAMPUS_MUSIC_SCOPE=vocal
# Optional space-separated IDs; leave unset to follow the complete selected scope.
# CAMPUS_MUSIC_IDS=music-char-hski-001 music-char-ttmr-001

# Compose interpolation: place this in .env or export before docker compose.
HATSUBOSHI_CREDENTIALS_DIR=/absolute/private/game-account
CAMPUS_MASTER_SOURCE=api

# First initialization only; omit on restart to reuse persisted settings.
# Formats: flac (default), mp3, aac (.m4a). Music remains FLAC.
# MP3/AAC default 128 kbps; FLAC requires an empty bitrate.
CAMPUS_VOICE_FORMAT=flac
CAMPUS_VOICE_BITRATE=
