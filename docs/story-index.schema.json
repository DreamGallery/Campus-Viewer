        "kind": {
          "enum": [
            "character",
            "main_part",
            "main_chapter",
            "story_group",
            "event",
            "idol_card",
            "support_card",
            "produce_mode",
            "produce_story_family"
          ]
        },
        "title": {
          "type": "string"
        },
        "title_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer"
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "source_record_id": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "visible_if": {
          "type": "string"
        },
        "unlocked_if": {
          "type": "string"
