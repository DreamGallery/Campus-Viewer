{
  "type": "object",
  "required": [
    "schema_version",
    "generator_version",
    "sources",
    "categories",
    "characters",
    "groups",
    "entries",
    "scripts",
    "memberships",
    "condition_sets",
    "source_records",
    "diagnostics",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "generator_version": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "required": [
        "masterdata",
        "stories"
      ],
      "properties": {
        "masterdata": {
          "type": "object",
          "required": [
            "git_commit",
            "content_sha256",
            "files"
          ],
          "properties": {
            "git_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "content_sha256": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "stories": {
          "type": "object",
          "required": [
            "git_commit",
            "content_sha256",
            "files"
          ],
          "properties": {
            "git_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "content_sha256": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/script"
      }
    },
    "memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/membership"
      }
    },
    "condition_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_record"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    },
    "stats": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gakumas story index v2",
  "$defs": {
    "category": {
      "type": "object",
      "required": [
        "id",
        "name",
        "parent_id",
        "entry_count",
        "script_count",
        "scripts_with_text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_count": {
          "type": "integer"
        },
        "script_count": {
          "type": "integer"
        },
        "scripts_with_text": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "name",
        "is_playable",
        "speaker_names",
        "speaker_patterns",
        "order",
        "source_record_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "is_playable": {
          "type": "boolean"
