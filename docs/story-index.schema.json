      "type": "object",
      "required": [
        "id",
        "table",
        "key",
        "key_strategy",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "key": {
          "type": "object"
        },
        "key_strategy": {
          "enum": [
            "explicit",
            "content_hash"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
