        "force_unlocked_if": {
          "type": "string"
        },
        "item_unlocked_if": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "script_id",
        "title",
        "title_language",
        "title_source",
        "category_id",
        "classification_basis",
        "character_ids",
        "inferred_character_ids",
        "idol_card_ids",
        "support_card_ids",
        "produce_mode_ids",
        "group_ids",
        "order",
        "conditions",
        "hints",
        "previous_entry_id",
        "source_type",
        "source_record_id",
        "source_field",
        "context",
        "voice_bindings"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
