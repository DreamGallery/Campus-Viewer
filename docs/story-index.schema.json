          "type": [
            "string",
            "null"
          ]
        },
        "file_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_text_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_row_count": {
          "type": "integer"
        },
        "translated_row_count": {
          "type": "integer"
        },
        "text_status": {
          "enum": [
            "present",
            "empty",
            "missing"
