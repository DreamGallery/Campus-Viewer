        "speaker_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "integer"
        },
        "source_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "title_language",
        "parent_id",
        "parent_basis",
        "order",
        "character_ids",
        "image_asset_id",
        "conditions",
        "source_record_id",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string"
