    "script": {
      "type": "object",
      "required": [
        "id",
        "asset_id",
        "entry_ids",
        "source_record_ids",
        "category_ids",
        "character_ids",
        "inferred_character_ids",
        "csv_path",
        "file_sha256",
        "source_text_sha256",
        "text_row_count",
        "translated_row_count",
        "text_status",
        "metadata_status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "asset_id": {
          "type": "string"
        },
        "entry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred_character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
