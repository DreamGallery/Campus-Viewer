        "character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred_character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idol_card_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_card_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produce_mode_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "integer"
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous_entry_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "object"
        },
        "voice_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_field",
              "asset_id"
            ],
            "properties": {
              "source_field": {
                "type": "string"
              },
              "asset_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
