        "title_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "title_source": {
          "enum": [
            "source",
            "generated",
            "asset_id"
          ]
        },
        "category_id": {
          "type": "string"
        },
        "classification_basis": {
          "enum": [
            "source_type",
            "explicit_relation",
            "shared_script",
            "filename_hint",
            "fallback"
          ]
