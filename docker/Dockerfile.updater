FROM python:3.12-slim-bookworm AS python-base
ARG DEBIAN_MIRROR=https://deb.debian.org
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir --index-url "$PIP_INDEX_URL" --upgrade pip

FROM python-base AS decoder
RUN apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends git cmake build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/build_vgmstream.sh scripts/build_vgmstream.sh
RUN sh scripts/build_vgmstream.sh

FROM python-base AS audio-codecs
RUN apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends curl xz-utils build-essential pkg-config nasm libmp3lame-dev && rm -rf /var/lib/apt/lists/*
COPY scripts/build_ffmpeg_audio.sh /build/build_ffmpeg_audio.sh
RUN sh /build/build_ffmpeg_audio.sh

FROM python-base AS masterdb-wheels
RUN apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends git build-essential libsqlcipher-dev && rm -rf /var/lib/apt/lists/*
ARG HATSUBOSHI_TOOLKIT_REF=40b89a4eca984fdcff1548cfc0b495ede194b253
COPY requirements.txt requirements-audio.txt requirements-assets.txt requirements-r2.txt /constraints/
RUN pip wheel --index-url "$PIP_INDEX_URL" --wheel-dir /wheels -r /constraints/requirements-r2.txt "hatsuboshi-masterdb @ git+https://github.com/DreamGallery/HatsuboshiToolkit.git@${HATSUBOSHI_TOOLKIT_REF}"

FROM python-base
RUN apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends git libstdc++6 flac libmp3lame0 libsqlcipher0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-audio.txt requirements-assets.txt requirements-r2.txt ./
RUN --mount=type=bind,from=masterdb-wheels,source=/wheels,target=/wheels \
    pip install --no-cache-dir --no-index --find-links=/wheels -r requirements-r2.txt hatsuboshi-masterdb
COPY --from=audio-codecs /opt/ffmpeg-audio/bin/ /usr/local/bin/
COPY --from=audio-codecs /opt/ffmpeg-audio/share/licenses/ffmpeg/ /usr/local/share/licenses/ffmpeg/
COPY --from=decoder /build/tools/vgmstream-build/cli/vgmstream-cli /usr/local/bin/vgmstream-cli
COPY --from=decoder /build/tools/vgmstream-src/COPYING /usr/local/share/licenses/vgmstream/COPYING
COPY campus_story_index ./campus_story_index
COPY scripts/verify_web_export.py ./scripts/verify_web_export.py
ENV PYTHONUNBUFFERED=1 CAMPUS_RUNTIME_ROOT=/runtime CAMPUS_MASTER_SOURCE=api HATSUBOSHI_CREDENTIALS_FILE=/credentials/account.json \
    GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt
CMD ["python", "-m", "campus_story_index.runtime_update"]
