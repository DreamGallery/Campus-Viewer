FROM python:3.12-slim-bookworm AS decoder
ARG DEBIAN_MIRROR=https://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends ca-certificates git cmake build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/build_vgmstream.sh scripts/build_vgmstream.sh
RUN sh scripts/build_vgmstream.sh

FROM python:3.12-slim-bookworm
ARG DEBIAN_MIRROR=https://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends git ca-certificates libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-audio.txt requirements-assets.txt requirements-r2.txt ./
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements-r2.txt
COPY --from=decoder /build/tools/vgmstream-build/cli/vgmstream-cli /usr/local/bin/vgmstream-cli
COPY --from=decoder /build/tools/vgmstream-src/COPYING /usr/local/share/licenses/vgmstream/COPYING
COPY campus_story_index ./campus_story_index
COPY scripts/verify_web_export.py ./scripts/verify_web_export.py
ENV PYTHONUNBUFFERED=1 CAMPUS_RUNTIME_ROOT=/runtime
CMD ["python", "-m", "campus_story_index.runtime_update"]
